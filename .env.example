# Supabase Postgres — use the DIRECT connection string for a long-running server
# (Project Settings → Database → Connection string → "Direct connection", port 5432).
# On an IPv4-only host, use the Session pooler string instead (also port 5432). SSL is required.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

SESSION_SECRET=change-me-to-a-random-string
# SESSION_SECRET is REQUIRED in production — the app refuses to start without it.
# CSRF is auto-enforced when NODE_ENV=production; set CSRF_ENABLED=1 to also
# enforce it in dev/test. See docs/DEPLOYMENT.md.
# NODE_ENV=production
# CSRF_ENABLED=1
ADMIN_USER=admin
ADMIN_EMAIL=admin@sap.com
ADMIN_PASSWORD_HASH=bcrypt-hash-of-your-password

# Public base URL of wherever the app is hosted (Render, Fly.io, etc.)
BASE_URL=https://your-app.example.com
PORT=3000

# Supabase Storage — uploaded prototype .html files live in a PRIVATE bucket.
# Create a bucket (default name "prototypes") in the Supabase dashboard first.
# SUPABASE_URL and the service_role key come from Project Settings → API.
# The service_role key is secret — server-side only, never ship it to the browser.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=prototypes

# Local-AI integration — the MCP client (mcp/server.mjs) uses these on the
# DEVELOPER'S machine; the deployed server needs neither (tokens live in the DB).
# Generate the token in the admin "API Tokens" panel (shown once).
# PROTOSHARE_TOKEN=paste-a-generated-token-here
# PROTOSHARE_MANIFEST=./.protoshare.json   # path to the manifest (default shown)
